
/*
  ==========================================
  Arduino Obstacle Avoiding Car
  عربية روبوت بتتفادى العوائق تلقائيًا
  ==========================================

  فكرة المشروع:
  1. قراءة المسافة باستخدام Ultrasonic Sensor.
  2. التحرك للأمام طالما الطريق مفتوح.
  3. التوقف والرجوع للخلف عند اكتشاف عائق.
  4. تحريك السيرفو لفحص اليمين واليسار.
  5. اختيار الاتجاه الذي يحتوي على مساحة أكبر.

  المكتبات المطلوبة:
  AFMotor  : للتحكم في الموتورات باستخدام Motor Shield V1.
  NewPing : لقراءة المسافة من حساس الموجات فوق الصوتية.
  Servo   : للتحكم في زاوية السيرفو.
*/

// استدعاء مكتبة التحكم في الموتورات
#include <AFMotor.h>

// استدعاء مكتبة التعامل مع حساس Ultrasonic
#include <NewPing.h>

// استدعاء مكتبة التحكم في Servo Motor
#include <Servo.h>


// ==========================================
// أولًا: تعريف المنافذ والثوابت
// ==========================================

// منفذ إرسال الموجات من الحساس TRIG
#define TRIG_PIN A0

// منفذ استقبال الموجات المنعكسة ECHO
#define ECHO_PIN A1

// أقصى مسافة سيقيسها الحساس بالسنتيمتر
#define MAX_DISTANCE 200

// السرعة القصوى للموتورات (من 0 إلى 255)
#define MAX_SPEED 190

// قيمة إضافية للسرعة، موجودة في الكود الأصلي
// لكنها غير مستخدمة حاليًا
#define MAX_SPEED_OFFSET 20


// إنشاء كائن للحساس وتحديد منافذ TRIG و ECHO
// وتحديد أقصى مسافة للقياس
NewPing sonar(TRIG_PIN, ECHO_PIN, MAX_DISTANCE);


// إنشاء كائن لكل موتور على Motor Shield
// الرقم بين القوسين هو رقم منفذ الموتور على الشيلد

// الموتور الأول على المنفذ M1
AF_DCMotor motor1(1, MOTOR12_1KHZ);

// الموتور الثاني على المنفذ M2
AF_DCMotor motor2(2, MOTOR12_1KHZ);

// الموتور الثالث على المنفذ M3
AF_DCMotor motor3(3, MOTOR34_1KHZ);

// الموتور الرابع على المنفذ M4
AF_DCMotor motor4(4, MOTOR34_1KHZ);


// إنشاء كائن للتحكم في السيرفو
Servo myservo;


// متغير لتحديد هل العربية تتحرك للأمام أم لا
// false = لا تتحرك للأمام حسب حالة البرنامج
// true  = تم تفعيل حركة الأمام
boolean goesForward = false;


// تخزين آخر مسافة مقروءة من الحساس
// القيمة الابتدائية 100 سم
int distance = 100;


// متغير مؤقت للتحكم في زيادة سرعة الموتورات تدريجيًا
int speedSet = 0;


// ==========================================
// ثانيًا: دالة setup
// تعمل مرة واحدة عند تشغيل الأردوينو
// ==========================================

void setup() {

  // توصيل السيرفو بالمنفذ D10
  myservo.attach(10);

  // توجيه الحساس ناحية الأمام بزاوية 115 درجة
  myservo.write(115);

  // انتظار ثانيتين حتى يستقر السيرفو
  delay(2000);

  // قراءة المسافة لأول مرة
  distance = readPing();
  delay(100);

  // قراءة المسافة مرة ثانية
  distance = readPing();
  delay(100);

  // قراءة المسافة مرة ثالثة
  distance = readPing();
  delay(100);

  // قراءة المسافة مرة رابعة
  distance = readPing();
  delay(100);
}


// ==========================================
// ثالثًا: دالة loop
// تتكرر باستمرار طوال تشغيل الأردوينو
// ==========================================

void loop() {

  // متغير لتخزين المسافة ناحية اليمين
  int distanceR = 0;

  // متغير لتخزين المسافة ناحية اليسار
  int distanceL = 0;

  // تأخير بسيط قبل تنفيذ الخطوة التالية
  delay(40);


  // إذا كانت المسافة أمام العربية 15 سم أو أقل
  // فهذا يعني وجود عائق قريب
  if (distance <= 15)
  {

    // إيقاف جميع الموتورات
    moveStop();

    // انتظار قليل بعد التوقف
    delay(100);

    // تحريك العربية للخلف للابتعاد عن العائق
    moveBackward();

    // الاستمرار في الرجوع لمدة 300 مللي ثانية
    delay(300);

    // إيقاف العربية مرة أخرى
    moveStop();

    // انتظار قبل فحص الاتجاهات
    delay(200);


    // فحص المسافة ناحية اليمين
    distanceR = lookRight();

    // انتظار قليل
    delay(200);

    // فحص المسافة ناحية اليسار
    distanceL = lookLeft();

    // انتظار قليل بعد الفحص
    delay(200);


    // مقارنة المسافة المتاحة في الاتجاهين
    // إذا كانت اليمين أوسع أو مساوية لليسار
    if (distanceR >= distanceL)
    {

      // لف العربية ناحية اليمين
      turnRight();

      // إيقاف العربية بعد تنفيذ اللفة
      moveStop();

    }
    else
    {

      // إذا كانت اليسار أوسع، لف ناحية اليسار
      turnLeft();

      // إيقاف العربية بعد تنفيذ اللفة
      moveStop();

    }

  }
  else
  {

    // إذا لم يوجد عائق قريب، تحرك للأمام
    moveForward();

  }


  // تحديث المسافة أمام العربية
  // لاستخدامها في الدورة التالية من loop
  distance = readPing();

}


// ==========================================
// رابعًا: دالة lookRight
// تفحص المسافة ناحية اليمين
// ==========================================

int lookRight()
{

    // توجيه السيرفو إلى زاوية 50 درجة
    // لفحص الاتجاه ناحية اليمين
    myservo.write(50);

    // انتظار حتى يتحرك السيرفو إلى موضعه
    delay(500);

    // قراءة المسافة في الاتجاه الذي يشير إليه الحساس
    int distance = readPing();

    // انتظار بسيط بعد القراءة
    delay(100);

    // إعادة الحساس إلى الاتجاه الأمامي
    myservo.write(115);

    // إرجاع المسافة المقاسة إلى الدالة التي استدعتها
    return distance;
}


// ==========================================
// خامسًا: دالة lookLeft
// تفحص المسافة ناحية اليسار
// ==========================================

int lookLeft()
{

    // توجيه السيرفو إلى زاوية 170 درجة
    // لفحص الاتجاه ناحية اليسار
    myservo.write(170);

    // انتظار حتى يصل السيرفو إلى موضعه
    delay(500);

    // قراءة المسافة ناحية اليسار
    int distance = readPing();

    // انتظار بسيط بعد القراءة
    delay(100);

    // إعادة الحساس إلى الاتجاه الأمامي
    myservo.write(115);

    // إرجاع المسافة المقاسة
    return distance;

    // ملاحظة: هذا التأخير لن يُنفذ
    // لأن return تنهي الدالة مباشرة
    // delay(100);
}


// ==========================================
// سادسًا: دالة readPing
// تقرأ المسافة من حساس Ultrasonic بالسنتيمتر
// ==========================================

int readPing()
{

  // انتظار بسيط قبل قراءة الحساس
  delay(70);

  // قياس المسافة باستخدام مكتبة NewPing
  // النتيجة تكون بالسنتيمتر
  int cm = sonar.ping_cm();

  // إذا كانت القراءة صفرًا
  // فهذا يعني أن الحساس لم يُرجع مسافة صالحة
  if (cm == 0)
  {

    // اعتبار المسافة 250 سم
    // حتى تتعامل العربية مع القراءة كأن الطريق مفتوح
    cm = 250;

  }

  // إرجاع المسافة المقاسة
  return cm;

}


// ==========================================
// سابعًا: دالة moveStop
// توقف جميع الموتورات
// ==========================================

void moveStop()
{

  // إيقاف الموتور الأول
  motor1.run(RELEASE);

  // إيقاف الموتور الثاني
  motor2.run(RELEASE);

  // إيقاف الموتور الثالث
  motor3.run(RELEASE);

  // إيقاف الموتور الرابع
  motor4.run(RELEASE);

}


// ==========================================
// ثامنًا: دالة moveForward
// تحرك العربية للأمام
// ==========================================

void moveForward()
{

  // تنفيذ عملية تهيئة الحركة للأمام
  // فقط إذا لم تكن حالة البرنامج للأمام بالفعل
  if (!goesForward)
  {

    // تسجيل أن حالة الحركة أصبحت للأمام
    goesForward = true;

    // ضبط اتجاه الموتور الأول للأمام
    motor1.run(FORWARD);

    // ضبط اتجاه الموتور الثاني للأمام
    motor2.run(FORWARD);

    // ضبط اتجاه الموتور الثالث للأمام
    motor3.run(FORWARD);

    // ضبط اتجاه الموتور الرابع للأمام
    motor4.run(FORWARD);


    // زيادة السرعة تدريجيًا من 0 إلى أقل من MAX_SPEED
    // بمقدار 2 في كل خطوة
    for (speedSet = 0;
         speedSet < MAX_SPEED;
         speedSet += 2)
    {

      // ضبط سرعة الموتور الأول
      motor1.setSpeed(speedSet);

      // ضبط سرعة الموتور الثاني
      motor2.setSpeed(speedSet);

      // ضبط سرعة الموتور الثالث
      motor3.setSpeed(speedSet);

      // ضبط سرعة الموتور الرابع
      motor4.setSpeed(speedSet);

      // انتظار 5 مللي ثانية بين كل زيادة
      // لتقليل الزيادة المفاجئة في السرعة
      delay(5);

    }

  }

}


// ==========================================
// تاسعًا: دالة moveBackward
// تحرك العربية للخلف
// ==========================================

void moveBackward()
{

    // تسجيل أن العربية لم تعد في حالة الحركة للأمام
    goesForward = false;

    // تغيير اتجاه الموتور الأول للخلف
    motor1.run(BACKWARD);

    // تغيير اتجاه الموتور الثاني للخلف
    motor2.run(BACKWARD);

    // تغيير اتجاه الموتور الثالث للخلف
    motor3.run(BACKWARD);

    // تغيير اتجاه الموتور الرابع للخلف
    motor4.run(BACKWARD);


    // زيادة سرعة الموتورات تدريجيًا
    // حتى تصل إلى القيمة المحددة في MAX_SPEED
    for (speedSet = 0;
         speedSet < MAX_SPEED;
         speedSet += 2)
    {

      // ضبط سرعة الموتور الأول
      motor1.setSpeed(speedSet);

      // ضبط سرعة الموتور الثاني
      motor2.setSpeed(speedSet);

      // ضبط سرعة الموتور الثالث
      motor3.setSpeed(speedSet);

      // ضبط سرعة الموتور الرابع
      motor4.setSpeed(speedSet);

      // انتظار 5 مللي ثانية بين كل خطوة
      delay(5);

    }

}


// ==========================================
// عاشرًا: دالة turnRight
// تدوير العربية ناحية اليمين
// ==========================================

void turnRight()
{

  // تشغيل الموتور الأول للأمام
  motor1.run(FORWARD);

  // تشغيل الموتور الثاني للأمام
  motor2.run(FORWARD);

  // تشغيل الموتور الثالث للخلف
  motor3.run(BACKWARD);

  // تشغيل الموتور الرابع للخلف
  motor4.run(BACKWARD);


  // استمرار الحركة بهذه الطريقة لمدة نصف ثانية
  // مما يؤدي إلى دوران العربية ناحية اليمين
  delay(500);


  // إعادة اتجاه الموتورات الأربعة للأمام
  // بعد انتهاء مدة الدوران
  motor1.run(FORWARD);
  motor2.run(FORWARD);
  motor3.run(FORWARD);
  motor4.run(FORWARD);

}


// ==========================================
// الحادي عشر: دالة turnLeft
// تدوير العربية ناحية اليسار
// ==========================================

void turnLeft()
{

  // تشغيل الموتور الأول للخلف
  motor1.run(BACKWARD);

  // تشغيل الموتور الثاني للخلف
  motor2.run(BACKWARD);

  // تشغيل الموتور الثالث للأمام
  motor3.run(FORWARD);

  // تشغيل الموتور الرابع للأمام
  motor4.run(FORWARD);


  // استمرار الحركة بهذه الطريقة لمدة نصف ثانية
  // مما يؤدي إلى دوران العربية ناحية اليسار
  delay(500);


  // إعادة اتجاه الموتورات الأربعة للأمام
  // بعد انتهاء مدة الدوران
  motor1.run(FORWARD);
  motor2.run(FORWARD);
  motor3.run(FORWARD);
  motor4.run(FORWARD);

}
